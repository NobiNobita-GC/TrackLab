<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="PageBackgroundBrush" Color="#F5F6F8" />
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="White" />
    <SolidColorBrush x:Key="PanelBorderBrush" Color="#D9DDE3" />

    <SolidColorBrush x:Key="ModuleUnknownColor" Color="#88948B" />
    <SolidColorBrush x:Key="ModuleIdleColor" Color="#106B57" />
    <SolidColorBrush x:Key="ModuleRunningColor" Color="Green" />
    <SolidColorBrush x:Key="ModuleAlarmColor" Color="#FF4D4F" />
    <SolidColorBrush x:Key="ModuleDisabledColor" Color="#808080" />

    <SolidColorBrush x:Key="AlarmInfoColor" Color="#1677FF" />
    <SolidColorBrush x:Key="AlarmWarningColor" Color="#FAAD14" />
    <SolidColorBrush x:Key="AlarmErrorColor" Color="#FF4D4F" />
</ResourceDictionary>
