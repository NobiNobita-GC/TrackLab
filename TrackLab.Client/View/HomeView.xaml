<Window x:Class="TrackLab.Client.View.HomeView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:local="clr-namespace:TrackLab.Client.View" xmlns:cal="http://www.caliburnproject.org" xmlns:convert="clr-namespace:TrackLab.UI.Converters;assembly=TrackLab.UI" xmlns:menu="clr-namespace:TrackLab.Core.Menu;assembly=TrackLab.Core" mc:Ignorable="d" Title="TrackLab" Height="750" Width="1200" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <convert:StringToIconConverter x:Key="StringToIconConverter" />
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Background="#20252B">
            <TextBlock Text="TrackLab" Foreground="White" FontSize="24" FontWeight="Bold" VerticalAlignment="Center" Margin="20,0" />
        </Border>
        
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            
            <Border Background="#2B3038">
                <Grid>
                    <ListBox x:Name="MenuList" ItemsSource="{Binding MenuItems}" SelectedItem="{Binding SelectedMainMenu}" Background="#2B3038" BorderThickness="0" Margin="5">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Height" Value="50" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,2" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" CornerRadius="4">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="#3A414B" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="#4B5563" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Button Width="200" Height="50" Padding="15,0" Foreground="White" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Left" cal:Action.TargetWithoutContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}" cal:Message.Attach="[Event Click] = [Action SelectMainMenu($dataContext,$source)]">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Width="20" Height="20" Margin="0,0,12,0" Fill="White" Stretch="Uniform" Data="{Binding Name, Converter={StaticResource StringToIconConverter}}" />
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    
                    <!--二级菜单-->
                    <Popup x:Name="MenuPopup" Placement="Right" StaysOpen="False" AllowsTransparency="True">
                        <Border Background="#363C45" Padding="5" CornerRadius="4">
                            <ListBox ItemsSource="{Binding SubMenuItems}" Background="Transparent" BorderThickness="0">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Height" Value="50" />
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" CornerRadius="3">
                                                        <ContentPresenter VerticalAlignment="Center" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="ItemBorder" Property="Background" Value="#4B525D" />
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="ItemBorder" Property="Background" Value="#555D69" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Button Height="50" Padding="15,0" Foreground="White" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Left" cal:Action.TargetWithoutContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}" cal:Message.Attach="[Event Click] = [Action SelectSubMenu($dataContext)]">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Width="20" Height="20" Margin="0,0,12,0" Fill="White" Stretch="Uniform" Data="{Binding Name, Converter={StaticResource StringToIconConverter}}" />
                                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                    </Popup>
                    
                </Grid>
            </Border>
            <ContentControl Grid.Column="1" cal:View.Model="{Binding CurrentView}" />
        </Grid>
    </Grid>
</Window>
