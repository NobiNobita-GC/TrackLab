<UserControl x:Class="TrackLab.Client.View.HardwareMonitorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="15" Background="#F5F6F8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="15" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <!--  Module  -->
        <Border Grid.Column="0"
                Background="White"
                BorderBrush="#D9DDE3"
                BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="50" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Margin="15,0"
                           VerticalAlignment="Center"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Text="Modules" />
                <ListBox Grid.Row="1"
                         BorderThickness="0"
                         DisplayMemberPath="Name"
                         FontSize="15"
                         ItemsSource="{Binding Modules}"
                         SelectedItem="{Binding SelectedModule, Mode=TwoWay}" />
            </Grid>
        </Border>
        <!--  DI / DO  -->
        <Grid Grid.Column="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="15" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <!--  DI  -->
            <Border Grid.Column="0"
                    Background="White"
                    BorderBrush="#D9DDE3"
                    BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="50" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <!--<TextBlock Text="DI" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" Margin="15,0"/>-->
                    <Grid>
                        <TextBlock Margin="15,0"
                                   VerticalAlignment="Center"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Text="DI" />
                        <Button x:Name="ToggleWaferPresent"
                                Width="160"
                                Height="30"
                                Margin="0,0,10,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Content="Toggle WaferPresent" />
                    </Grid>
                    <DataGrid Grid.Row="1"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              HeadersVisibility="Column"
                              IsReadOnly="True"
                              ItemsSource="{Binding DIs}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Width="80"
                                                Binding="{Binding Index}"
                                                Header="Index" />
                            <DataGridTextColumn Width="*"
                                                Binding="{Binding Name}"
                                                Header="Name" />
                            <DataGridCheckBoxColumn Width="100"
                                                    Binding="{Binding Value, Mode=OneWay}"
                                                    Header="Value" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
            <!--  DO  -->
            <Border Grid.Column="2"
                    Background="White"
                    BorderBrush="#D9DDE3"
                    BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="50" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Margin="15,0"
                               VerticalAlignment="Center"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Text="DO" />
                    <DataGrid Grid.Row="1"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              HeadersVisibility="Column"
                              IsReadOnly="True"
                              ItemsSource="{Binding DOs}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Width="80"
                                                Binding="{Binding Index}"
                                                Header="Index" />
                            <DataGridTextColumn Width="*"
                                                Binding="{Binding Name}"
                                                Header="Name" />
                            <DataGridCheckBoxColumn Width="100"
                                                    Binding="{Binding Value, Mode=OneWay}"
                                                    Header="Value" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>