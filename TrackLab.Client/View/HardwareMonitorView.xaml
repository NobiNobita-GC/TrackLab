<UserControl x:Class="TrackLab.Client.View.HardwareMonitorView" 
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="#F5F6F8" Margin="15">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="15"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <!-- Module -->
        <Border Grid.Column="0" Background="White" BorderBrush="#D9DDE3" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="50"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Modules" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" Margin="15,0"/>
                <ListBox Grid.Row="1" ItemsSource="{Binding Modules}" SelectedItem="{Binding SelectedModule, Mode=TwoWay}" DisplayMemberPath="Name" BorderThickness="0" FontSize="15"/>
            </Grid>
        </Border>
        <!-- DI / DO -->
        <Grid Grid.Column="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="15"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <!-- DI -->
            <Border Grid.Column="0" Background="White" BorderBrush="#D9DDE3" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="50"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <!--<TextBlock Text="DI" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" Margin="15,0"/>-->
                    <Grid>
                        <TextBlock Text="DI" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" Margin="15,0"/>
                        <Button x:Name="ToggleWaferPresent" Content="Toggle WaferPresent" Width="160" Height="30" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    </Grid>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding DIs}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Index" Binding="{Binding Index}" Width="80"/>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                            <DataGridCheckBoxColumn Header="Value" Binding="{Binding Value, Mode=OneWay}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
            <!-- DO -->
            <Border Grid.Column="2" Background="White" BorderBrush="#D9DDE3" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="50"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="DO" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" Margin="15,0"/>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding DOs}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Index" Binding="{Binding Index}" Width="80"/>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                            <DataGridCheckBoxColumn Header="Value" Binding="{Binding Value, Mode=OneWay}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>