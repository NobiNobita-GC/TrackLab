<UserControl x:Class="TrackLabClient.View.Log.AlarmView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:alarm="clr-namespace:Core.Alarm;assembly=Core">

    <Grid Background="#F5F6F8">
        <Grid.RowDefinitions>
            <RowDefinition Height="60" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Margin="20,0"
                   VerticalAlignment="Center"
                   FontSize="24"
                   FontWeight="SemiBold"
                   Text="Alarm" />

        <Button x:Name="AddTestAlarm"
                Width="120"
                Height="32"
                Margin="0,0,20,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Content="Add Test Alarm" />

        <Border Grid.Row="1"
                Margin="20"
                Padding="15"
                Background="White"
                CornerRadius="4">

            <DataGrid AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      IsReadOnly="True"
                      ItemsSource="{Binding Alarms}">

                <DataGrid.Columns>
                    <DataGridTextColumn Width="120"
                                        Binding="{Binding Time, StringFormat=HH:mm:ss}"
                                        Header="Time" />

                    <DataGridTextColumn Width="150"
                                        Binding="{Binding Module}"
                                        Header="Module" />

                    <DataGridTemplateColumn Width="120" Header="Level">

                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Level}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">

                                            <Setter Property="Foreground" Value="{StaticResource AlarmInfoColor}" />

                                            <Style.Triggers>

                                                <DataTrigger Binding="{Binding Level}" Value="{x:Static alarm:AlarmLevel.Warning}">
                                                    <Setter Property="Foreground" Value="{StaticResource AlarmWarningColor}" />
                                                </DataTrigger>

                                                <DataTrigger Binding="{Binding Level}" Value="{x:Static alarm:AlarmLevel.Error}">
                                                    <Setter Property="Foreground" Value="{StaticResource AlarmErrorColor}" />
                                                </DataTrigger>

                                            </Style.Triggers>

                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>

                    </DataGridTemplateColumn>

                    <DataGridTextColumn Width="*"
                                        Binding="{Binding Message}"
                                        Header="Message" />
                </DataGrid.Columns>

            </DataGrid>

        </Border>
    </Grid>
</UserControl>
