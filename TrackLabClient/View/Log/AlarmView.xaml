<UserControl x:Class="TrackLabClient.View.Log.AlarmView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lan="clr-namespace:UI.Extension;assembly=UI"
             xmlns:alarm="clr-namespace:Core.Alarm;assembly=Core">

    <Grid Background="{StaticResource PageBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="60" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Margin="20,0"
                   VerticalAlignment="Center"
                   FontSize="24"
                   FontWeight="SemiBold"
                   lan:LanguageExtension.Text="AlarmList" />

        <StackPanel Orientation="Horizontal" Margin="140,0,0,0"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Center"
                   ><TextBlock Margin="0,0,6,0" lan:LanguageExtension.Text="CountLabel" /><TextBlock Text="{Binding DisplayedAlarms.Count}" /></StackPanel>

        <TextBox Width="180"
                 Height="30"
                 Margin="220,0,0,0"
                 HorizontalAlignment="Left"
                 VerticalAlignment="Center"
                 VerticalContentAlignment="Center"
                 Text="{Binding SearchMessage, UpdateSourceTrigger=PropertyChanged}"
                 ><TextBox.ToolTip><TextBlock lan:LanguageExtension.Text="Message" /></TextBox.ToolTip></TextBox>

        <Button x:Name="Query"
                Width="80"
                Height="30"
                Margin="410,0,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                lan:LanguageExtension.Text="Query" />

        <TextBox Width="180"
                 Height="30"
                 Margin="590,0,0,0"
                 HorizontalAlignment="Left"
                 VerticalAlignment="Center"
                 VerticalContentAlignment="Center"
                 Text="{Binding SearchName, UpdateSourceTrigger=PropertyChanged}"
                 ><TextBox.ToolTip><TextBlock lan:LanguageExtension.Text="Name" /></TextBox.ToolTip></TextBox>

        <Button x:Name="CancelQuery"
                Width="80"
                Height="30"
                Margin="500,0,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                lan:LanguageExtension.Text="Cancel" />

        <Button x:Name="AddTestAlarm"
                Width="120"
                Height="32"
                Margin="0,0,20,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                lan:LanguageExtension.Text="AddTestAlarm" />

        <Button x:Name="RemoveSelectedAlarm"
                Width="140"
                Height="32"
                Margin="0,0,150,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                lan:LanguageExtension.Text="RemoveSelected" />

        <Border Grid.Row="1"
                Margin="20"
                Padding="15"
                Background="{StaticResource PanelBackgroundBrush}"
                BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="1"
                CornerRadius="4">

            <DataGrid AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      IsReadOnly="True"
                      ItemsSource="{Binding DisplayedAlarms}"
                      SelectedItem="{Binding SelectedAlarm}">

                <DataGrid.Columns>
                    <DataGridTextColumn Width="120"
                                        Binding="{Binding Time, StringFormat=HH:mm:ss}"
                                        ><DataGridTextColumn.Header><TextBlock lan:LanguageExtension.Text="Time" /></DataGridTextColumn.Header></DataGridTextColumn>

                    <DataGridTextColumn Width="120" Binding="{Binding Module}">
                        <DataGridTextColumn.Header>
                            <TextBlock lan:LanguageExtension.Text="Module" />
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>

                    <DataGridTextColumn Width="160" Binding="{Binding Name}">
                        <DataGridTextColumn.Header>
                            <TextBlock lan:LanguageExtension.Text="Name" />
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>

                    <DataGridTemplateColumn Width="120">
                        <DataGridTemplateColumn.Header><TextBlock lan:LanguageExtension.Text="Level" /></DataGridTemplateColumn.Header>

                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Level}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">

                                            <Setter Property="Foreground" Value="{StaticResource AlarmInfoColor}" />

                                            <Style.Triggers>

                                                <DataTrigger Binding="{Binding Level}" Value="{x:Static alarm:AlarmLevel.Warning}">
                                                    <Setter Property="Foreground" Value="{StaticResource AlarmWarningColor}" />
                                                </DataTrigger>

                                                <DataTrigger Binding="{Binding Level}" Value="{x:Static alarm:AlarmLevel.Error}">
                                                    <Setter Property="Foreground" Value="{StaticResource AlarmErrorColor}" />
                                                </DataTrigger>

                                            </Style.Triggers>

                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>

                    </DataGridTemplateColumn>

                    <DataGridTextColumn Width="*" Binding="{Binding Message}">
                        <DataGridTextColumn.Header>
                            <TextBlock lan:LanguageExtension.Text="Message" />
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>

                    <DataGridTextColumn Width="*" Binding="{Binding Cause}">
                        <DataGridTextColumn.Header>
                            <TextBlock lan:LanguageExtension.Text="Cause" />
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>

                    <DataGridTextColumn Width="*" Binding="{Binding Solution}">
                        <DataGridTextColumn.Header>
                            <TextBlock lan:LanguageExtension.Text="Solution" />
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                </DataGrid.Columns>

            </DataGrid>

        </Border>
    </Grid>
</UserControl>
