<UserControl x:Class="TrackLabClient.View.Status.ModuleDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="420"
             Height="280">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="50" />
            <RowDefinition Height="45" />
            <RowDefinition Height="45" />
            <RowDefinition Height="45" />
            <RowDefinition Height="45" />
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0"
                   FontSize="22"
                   FontWeight="SemiBold"
                   Text="Module Information" />
        <StackPanel Grid.Row="1" Orientation="Horizontal">
            <TextBlock Width="100"
                       FontWeight="SemiBold"
                       Text="Name:" />
            <TextBlock Text="{Binding Module.Name}" />
        </StackPanel>
        <StackPanel Grid.Row="2" Orientation="Horizontal">
            <TextBlock Width="100"
                       FontWeight="SemiBold"
                       Text="Index:" />
            <TextBlock Text="{Binding Module.Index}" />
        </StackPanel>
        <StackPanel Grid.Row="3" Orientation="Horizontal">
            <TextBlock Width="100"
                       FontWeight="SemiBold"
                       Text="Type:" />
            <TextBlock Text="{Binding Module.Type}" />
        </StackPanel>
        <StackPanel Grid.Row="4" Orientation="Horizontal">
            <TextBlock Width="100"
                       FontWeight="SemiBold"
                       Text="State:" />
            <TextBlock Text="{Binding Module.State}" />
        </StackPanel>
    </Grid>
</UserControl>
