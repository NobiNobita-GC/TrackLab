<UserControl x:Class="TrackLabClient.View.Status.CoolPlateModuleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:TrackLabClient.View.Status"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             Width="500"
             Height="350"
             mc:Ignorable="d">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="50" />
            <RowDefinition Height="40" />
            <RowDefinition Height="40" />
            <RowDefinition Height="40" />
            <RowDefinition Height="40" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   FontSize="24"
                   FontWeight="SemiBold"
                   Text="Cool Plate" />
        <TextBlock Grid.Row="1"
                   FontSize="18"
                   Text="{Binding Module.Name}" />
        <TextBlock Grid.Row="2" Text="{Binding Module.Index, StringFormat=Index: {0}}" />
        <TextBlock Grid.Row="3" Text="{Binding Module.State, StringFormat=State: {0}}" />
        <TextBlock Grid.Row="4" Text="Temperature: -- °C" />

    </Grid>
</UserControl>
