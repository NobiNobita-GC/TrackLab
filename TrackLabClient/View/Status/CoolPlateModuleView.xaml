<UserControl x:Class="TrackLabClient.View.Status.CoolPlateModuleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lan="clr-namespace:UI.Extension;assembly=UI"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:TrackLabClient.View.Status"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             Width="500"
             Height="350"
             mc:Ignorable="d">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="50" />
            <RowDefinition Height="40" />
            <RowDefinition Height="40" />
            <RowDefinition Height="40" />
            <RowDefinition Height="40" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   FontSize="24"
                   FontWeight="SemiBold"
                   lan:LanguageExtension.Text="CoolPlate" />
        <TextBlock Grid.Row="1"
                   FontSize="18"
                   Text="{Binding Module.Name}" />
        <StackPanel Grid.Row="2" Orientation="Horizontal">
            <TextBlock Margin="0,0,6,0" lan:LanguageExtension.Text="IndexLabel" />
            <TextBlock Text="{Binding Module.Index}" />
        </StackPanel>
        <StackPanel Grid.Row="3" Orientation="Horizontal">
            <TextBlock Margin="0,0,6,0" lan:LanguageExtension.Text="StateLabel" />
            <TextBlock lan:LanguageExtension.Text="{Binding Module.State}" />
        </StackPanel>
        <TextBlock Grid.Row="4" lan:LanguageExtension.Text="TemperatureUnavailable" />

    </Grid>
</UserControl>
