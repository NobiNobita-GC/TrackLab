<UserControl x:Class="TrackLabClient.View.Configuration.LanguageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cal="http://www.caliburnproject.org"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:TrackLabClient.View.Configuration"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DesignHeight="450"
             d:DesignWidth="800"
             mc:Ignorable="d">

    <StackPanel HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Orientation="Horizontal">

        <Button Width="200"
                Height="100"
                Margin="30"
                cal:Message.Attach="[Event Click] = [Action SetLanguage('en')]"
                Content="English" />

        <Button Width="200"
                Height="100"
                Margin="30"
                cal:Message.Attach="[Event Click] = [Action SetLanguage('cn')]"
                Content="中文" />

    </StackPanel>

</UserControl>
