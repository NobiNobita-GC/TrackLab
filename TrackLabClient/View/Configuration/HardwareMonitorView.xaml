<UserControl x:Class="TrackLabClient.View.Configuration.HardwareMonitorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:display="clr-namespace:UI.Control.Display;assembly=UI">
    <Grid Margin="15" Background="{StaticResource PageBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="15" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <!--  Module  -->
        <Border Grid.Column="0"
                Background="{StaticResource PanelBackgroundBrush}"
                BorderBrush="#D9DDE3"
                BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="50" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Margin="15,0"
                           VerticalAlignment="Center"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Text="Modules" />
                <ListBox Grid.Row="1"
                         BorderThickness="0"
                         DisplayMemberPath="Name"
                         FontSize="15"
                         ItemsSource="{Binding Modules}"
                         SelectedItem="{Binding SelectedModule, Mode=TwoWay}" />
            </Grid>
        </Border>
        <!--  DI / DO  -->
        <Grid Grid.Column="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="15" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <!--  DI  -->
            <Border Grid.Column="0"
                    Background="{StaticResource PanelBackgroundBrush}"
                    BorderBrush="#D9DDE3"
                    BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="50" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <!--<TextBlock Text="DI" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" Margin="15,0"/>-->
                    <Grid>
                        <TextBlock Margin="15,0"
                                   VerticalAlignment="Center"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Text="DI" />
                        <Button x:Name="ToggleWaferPresent"
                                Width="160"
                                Height="30"
                                Margin="0,0,10,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Content="Toggle WaferPresent" />
                    </Grid>
                    <display:IODisplay Grid.Row="1" Items="{Binding DIs}" />
                </Grid>
            </Border>
            <!--  DO  -->
            <Border Grid.Column="2"
                    Background="{StaticResource PanelBackgroundBrush}"
                    BorderBrush="#D9DDE3"
                    BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="50" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Margin="15,0"
                               VerticalAlignment="Center"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Text="DO" />
                    <display:IODisplay Grid.Row="1" Items="{Binding DOs}" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
