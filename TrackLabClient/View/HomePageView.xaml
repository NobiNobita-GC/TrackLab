<UserControl x:Class="TrackLabClient.View.HomePageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lan="clr-namespace:UI.Extension;assembly=UI"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:TrackLabClient.View"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DesignHeight="450"
             d:DesignWidth="800"
             mc:Ignorable="d">
    <Grid Background="#F5F5F5">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock HorizontalAlignment="Center"
                       FontSize="36"
                       FontWeight="Bold"
                       lan:LanguageExtension.Text="HomePage" />
            <TextBlock Margin="0,15,0,0"
                       HorizontalAlignment="Center"
                       FontSize="18"
                       lan:LanguageExtension.Text="EquipmentOverview" />
        </StackPanel>
    </Grid>
</UserControl>
