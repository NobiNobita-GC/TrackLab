<UserControl x:Class="TrackLabClient.View.Recipe.RecipeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cal="http://caliburnmicro.com">

    <Grid Background="{StaticResource PageBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="60" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Margin="20,0"
                   VerticalAlignment="Center"
                   FontSize="24"
                   FontWeight="SemiBold"
                   Text="Recipe" />

        <Grid Grid.Row="1" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  左侧：配方树  -->
            <Border Padding="15"
                    Background="{StaticResource PanelBackgroundBrush}"
                    BorderBrush="{StaticResource PanelBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock VerticalAlignment="Center"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Text="Recipe Tree" />

                    <TreeView Grid.Row="1"
                              Margin="0,10,0,0"
                              cal:Message.Attach="[Event SelectedItemChanged] = [Action SelectedItemChanged($this)]"
                              ItemsSource="{Binding RecipeNodes}">

                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding SubNodes}">
                                <StackPanel Orientation="Horizontal">

                                    <TextBlock Width="24"
                                               VerticalAlignment="Center"
                                               FontFamily="Segoe UI Emoji">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="📄" />

                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsFolder}" Value="True">
                                                        <Setter Property="Text" Value="📁" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <TextBlock VerticalAlignment="Center" Text="{Binding Name}" />

                                </StackPanel>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>

                    </TreeView>
                </Grid>

            </Border>

            <!--  右侧：当前先显示配方概览  -->
            <Border Grid.Column="2"
                    Padding="20"
                    Background="{StaticResource PanelBackgroundBrush}"
                    BorderBrush="{StaticResource PanelBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="180" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!--  当前配方  -->
                    <TextBlock FontSize="20"
                               FontWeight="SemiBold"
                               Text="Recipe Detail" />

                    <!--  基本信息  -->
                    <Grid Grid.Row="1" Margin="0,20,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock VerticalAlignment="Center" Text="Name" />

                        <TextBox Grid.Column="1"
                                 Margin="5"
                                 IsReadOnly="True"
                                 Text="{Binding SelectedRecipe.Name, Mode=OneWay}" />

                        <TextBlock Grid.Column="2"
                                   VerticalAlignment="Center"
                                   Text="Type" />

                        <TextBox Grid.Column="3"
                                 Margin="5"
                                 IsReadOnly="True"
                                 Text="{Binding SelectedRecipe.RecipeType, Mode=OneWay}" />
                    </Grid>

                    <!--  Header  -->
                    <GroupBox Grid.Row="2" Header="Header">
                        <DataGrid Margin="10"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  IsReadOnly="True"
                                  ItemsSource="{Binding SelectedRecipe.RecipeData.Header}">

                            <DataGrid.Columns>

                                <DataGridTextColumn Width="200"
                                                    Binding="{Binding Key}"
                                                    Header="Key" />

                                <DataGridTextColumn Width="*"
                                                    Binding="{Binding Value}"
                                                    Header="Value" />

                            </DataGrid.Columns>

                        </DataGrid>
                    </GroupBox>

                    <!--  Step  -->
                    <GroupBox Grid.Row="3"
                              Margin="0,15,0,0"
                              Header="Step">

                        <DataGrid Margin="10"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  IsReadOnly="True"
                                  ItemsSource="{Binding SelectedRecipe.RecipeData.Step}">

                            <DataGrid.Columns>

                                <DataGridTemplateColumn Width="*" Header="Step Data">

                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>

                                            <ItemsControl ItemsSource="{Binding}">

                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>

                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>

                                                        <Border Margin="4"
                                                                Padding="8,4"
                                                                BorderBrush="{StaticResource PanelBorderBrush}"
                                                                BorderThickness="1"
                                                                CornerRadius="3">

                                                            <StackPanel Orientation="Horizontal">

                                                                <TextBlock FontWeight="SemiBold" Text="{Binding Key}" />

                                                                <TextBlock Margin="8,0,0,0" Text="{Binding Value}" />

                                                            </StackPanel>

                                                        </Border>

                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>

                                            </ItemsControl>

                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>

                                </DataGridTemplateColumn>

                            </DataGrid.Columns>

                        </DataGrid>

                    </GroupBox>

                </Grid>

            </Border>

        </Grid>
    </Grid>
</UserControl>
